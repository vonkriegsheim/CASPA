# Machine-local / user configs — may contain API keys, never commit
testset/**/config/caspa.json
caspa.json

# Data directories
testset/**/*.tsv
testset/**/*.parquet
testset/**/*.raw

# Testset — exclude everything, then allow only v3 prompt folder and data/
testset/**
!testset/
!testset/*/
!testset/*/scp/
!testset/*/scp/llm/
!testset/*/scp/llm/v3/
!testset/*/scp/llm/v3/**
!testset/*/data/
!testset/*/data/**

# Pipeline run artifacts — never commit, even if a workdir lands inside testset/
**/.snakemake/
testset/*/data/scp/
testset/*/data/config/
testset/*/data/caspa_input/

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
.venv/
.env

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# ELM API key for paper-revision experiments (never commit)
parperReview/response/.elm_key
paperReview/response/.elm_key
~$*
paperReview/
poster/
